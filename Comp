#include <stdio.h>

void display(int n)
{
    for (int i = 7; i >= 0; i--)
        printf("%d", (n >> i) & 1);
}

int main()
{
    int n = 0b11010101;
    int carry = 0;

    printf("Original number: ");
    display(n);

    printf("\nInitial Carry: %d", carry);

    for (int i = 1; i <= 2; i++)
    {
        int old_carry = carry;

        carry = n & 1;

        n = (n >> 1) | (old_carry << 7);

        printf("\nAfter rotation %d: ", i);
        display(n);

        printf(" Carry: %d", carry);
    }

    printf("\nFinal result: ");
    display(n);

    printf("\nFinal Carry: %d\n", carry);

    return 0;
}

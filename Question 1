#include <stdio.h>

void display(int n)
{
    for (int i = 7; i >= 0; i--)
        printf("%d", (n >> i) & 1);
}

int main()
{
    int n = 0b11010101;

    printf("Original number: ");
    display(n);

    for (int i = 1; i <= 2; i++)
    {
        int lsb = n & 1;

        n = (n >> 1) | (lsb << 7);

        printf("\nAfter rotation %d: ", i);
        display(n);
    }

    printf("\nFinal result: ");
    display(n);

    return 0;
}
